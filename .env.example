# NewApi - variables de entorno
#
# Copia este fichero a `.env` (ignorado por git) o define las variables en tu
# plataforma de despliegue / gestor de secretos. Ningun valor real se versiona.
#
# En .NET, el separador de secciones de configuracion es un doble guion bajo:
#   "Stripe": { "SecretKey": ... }   ->   Stripe__SecretKey

# ── Base de datos ─────────────────────────────────────────────
ConnectionStrings__PostgresConnection=Host=;Port=5432;Username=;Password=;Database=;SSL Mode=Require

# ── JWT ───────────────────────────────────────────────────────
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=

# ── Stripe ────────────────────────────────────────────────────
# PublishableKey es publica por diseno; SecretKey y los webhook secrets NO.
Stripe__PublishableKey=
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__GeneralWebhookSecret=
Stripe__BrandingLogoFileId=
Stripe__BrandingIconFileId=

# ── Supabase ──────────────────────────────────────────────────
Supabase__Url=
Supabase__AnonKey=
Supabase__ServiceRoleKey=

# ── Twilio (SMS / verificacion) ───────────────────────────────
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromNumber=
Twilio__MessagingServiceSid=
Twilio__VerificationServiceSid=

# ── Email SMTP ────────────────────────────────────────────────
Email__SmtpHost=
Email__SmtpPort=465
Email__SmtpUsername=
Email__SmtpPassword=
Email__FromEmail=
Email__FromName=

# ── OpenAI ────────────────────────────────────────────────────
OpenAI__ApiKey=

# ── Firebase (push FCM) ───────────────────────────────────────
# JSON completo de la service account en una sola linea. Vacio = push no-op.
Firebase__ServiceAccountJson=

# ── Google ────────────────────────────────────────────────────
# OAuth client IDs (public) — no pongas secretos de cliente aqui.
Google__ClientIds__0=
Google__ClientIds__1=
GoogleCloud__BucketName=

# ── JWT ───────────────────────────────────────────────────────
# Jwt__Key debe ser largo y aleatorio; NUNCA lo versionas.
# (bloque Jwt__* ya documentado arriba)

# ── Mapbox ────────────────────────────────────────────────────
Mapbox__PublicToken=

# ── MFA ───────────────────────────────────────────────────────
Mfa__EncryptionKey=

# ── Canales de alerta ─────────────────────────────────────────
AlertChannels__Slack__WebhookUrl=
AlertChannels__Telegram__BotToken=
AlertChannels__Telegram__ChatId=

# ── App ───────────────────────────────────────────────────────
App__Name=
App__FrontendBaseUrl=
AdminEmails=

# ── Scripts de migracion / utilidades locales ─────────────────
# Usados por Scripts/MigrateToRender.ps1 y test-postgres-connection.ps1
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
RENDER_DB_HOST=
RENDER_DB_PORT=5432
RENDER_DB_USER=
RENDER_DB_PASSWORD=
RENDER_DB_NAME=
PGPASSWORD=
