  // ─────────────────────────────────────────────────────────────────────────────
  //  PlatformFiscal · Perfil fiscal de la plataforma (DEFAULT INERTE / pre-alta)
  //  IsVatRegistered=false → recibo simple, sin alerta D11 por IVA=0, sin
  //                          numeración correlativa, sin menciones legales.
  //                          Comportamiento actual idéntico.
  //  Activación ("flip" cuando seas autónomo / empresa):
  //    1) Aplicar migración: dotnet ef database update --project NewApi
  //    2) Rellenar todos los campos vía env vars en Render (PlatformFiscal__*):
  //       PlatformFiscal__IsVatRegistered=true
  //       PlatformFiscal__LegalName=Diego Castilla Blanco
  //       PlatformFiscal__Nif=12345678Z
  //       PlatformFiscal__FiscalAddress__Street=Calle X 12
  //       PlatformFiscal__FiscalAddress__PostalCode=47001
  //       PlatformFiscal__FiscalAddress__City=Valladolid
  //       PlatformFiscal__FiscalAddress__Province=Valladolid
  //       PlatformFiscal__FiscalAddress__Country=ES
  //       PlatformFiscal__IaeCode=843.9
  //       PlatformFiscal__RoiRegistered=false  (true cuando estés en ROI/VIES)
  //       PlatformFiscal__OssRegistered=false  (true cuando estés en OSS UE)
  //    3) Reiniciar el web service. Sin recompilar.
  // ─────────────────────────────────────────────────────────────────────────────
  "PlatformFiscal": {
    "IsVatRegistered": false,
    "LegalName": "",
    "Nif": "",
    "FiscalAddress": {
      "Street": "",
      "PostalCode": "",
      "City": "",
      "Province": "",
      "Country": "ES"
    },
    "IaeCode": "",
    "RoiRegistered": false,
    "OssRegistered": false,
    "InvoiceSeriesPrefix": "INSP-",
    "InvoiceSeriesYear": 0
  }

