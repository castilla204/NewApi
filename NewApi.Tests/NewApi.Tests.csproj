<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS8618;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Assertions y mocks -->
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Bogus" Version="35.6.5" />

    <!-- Testcontainers PostgreSQL para integration tests con BD real -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />

    <!-- WebApplicationFactory: arranca el backend REAL (Program.cs) en tests HTTP -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <!-- EF Core (versión alineada con NewApi). Forzamos 10.0.8 también en Relational
         para evitar el aviso MSB3277 por mezcla de transient 10.0.0 / direct 10.0.8. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Coverage -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\newApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copiar SEED_ESTADOS_COMPLETO.sql al output para inicializar el testcontainer -->
    <None Include="..\SEED_ESTADOS_COMPLETO.sql" Link="Resources\SEED_ESTADOS_COMPLETO.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
